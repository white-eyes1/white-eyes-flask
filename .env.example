# 관리자 앱과 같은 값. 비어 있으면 모든 요청이 401
INTERNAL_API_TOKEN=change-me

# 탐지 모델: visdrone(기본, 위에서 본 사람 몸) | yolo-crowd(머리). 받는 법은 README
DETECTOR=visdrone

# 가중치 파일 경로 (저장소에 커밋하지 않음). DETECTOR에 맞는 파일이어야 한다
YOLO_WEIGHTS=/path/to/visdrone-yolov8m.pt

# 탐지 신뢰도 하한, 입력 크기, 초당 분석 프레임 수
# 입력 960은 이 PC(i7-4790) 기준 프레임당 약 0.5초라 초당 5프레임을 못 맞춘다(서버에서 느리면 낮춘다)
DETECT_CONF=0.3
DETECT_IMGSZ=960
ANALYZE_FPS=5

# 같은 사람을 둘로 센 박스를 합치는 겹침 기준(작은 박스 넓이 대비). 0이면 합치지 않는다
DETECT_DEDUPE_OVERLAP=0.25

# 유입/유출 판정선 위치(각 변에서 안쪽으로 화면 크기의 비율)
EDGE_MARGIN_RATIO=0.05

# 공유 폴더 경로. DUMMY 영상은 이 아래 dummy/videos/ 에 둔다
MEDIA_ROOT=/srv/media

# 더미 분석 캐시를 두는 분석 서버 로컬 폴더(공유 폴더가 아님)
CACHE_DIR=/var/lib/analyzer/cache

# 관리자 앱 내부 통신 주소(상태 보고 등)
ADMIN_INTERNAL_BASE_URL=http://localhost:8082

HOST=0.0.0.0
PORT=5000
